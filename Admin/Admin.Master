<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="Chetancbsewebsite.Admin.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Admin Control Panel | Chetan Public School</title>

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <!-- Custom School & Admin Styles -->
    <link href="~/Assets/css/style.css" rel="stylesheet" />

    <!-- Official School Favicon -->
    <link rel="icon" type="image/png" href='<%= ResolveUrl("~/Assets/images/logo.png") %>' />
    <link rel="apple-touch-icon" href='<%= ResolveUrl("~/Assets/images/logo.png") %>' />

    <asp:ContentPlaceHolder ID="AdminHead" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="adminForm" runat="server">
        <div class="d-flex" style="min-height: 100vh;">
            <!-- Admin Sidebar -->
            <aside class="admin-sidebar d-flex flex-column flex-shrink-0 p-3" style="width: 260px;">
                <a href="~/Admin/Dashboard.aspx" runat="server" class="d-flex align-items-center mb-4 text-white text-decoration-none">
                    <img src='<%= ResolveUrl("~/Assets/images/logo.png") %>' alt="CPS Logo" class="rounded-circle me-2 bg-white p-1 shadow-sm" style="width: 42px; height: 42px; object-fit: contain;" />
                    <div>
                        <div class="fw-bold fs-6">CPS ADMIN</div>
                        <div class="small text-secondary" style="font-size: 0.75rem;">Control Dashboard</div>
                    </div>
                </a>
                <hr class="border-secondary my-2">
                
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a href="~/Admin/Dashboard.aspx" runat="server" class="nav-link">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManagePopup.aspx" runat="server" class="nav-link">
                            <i class="bi bi-window-stack me-2 text-warning"></i> Home Modal Notice
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageAdmissionLink.aspx" runat="server" class="nav-link">
                            <i class="bi bi-link-45deg me-2 text-info"></i> Admission ERP / Drive Link
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageNews.aspx" runat="server" class="nav-link">
                            <i class="bi bi-megaphone me-2"></i> News & Tickers
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageGallery.aspx" runat="server" class="nav-link">
                            <i class="bi bi-images me-2"></i> Photo Gallery
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageStaff.aspx" runat="server" class="nav-link">
                            <i class="bi bi-person-badge me-2"></i> Faculty Directory
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageDisclosures.aspx" runat="server" class="nav-link">
                            <i class="bi bi-file-earmark-pdf me-2"></i> CBSE Disclosures
                        </a>
                    </li>
                    <li>
                        <a href="~/Admin/ManageTestimonials.aspx" runat="server" class="nav-link">
                            <i class="bi bi-chat-heart me-2 text-danger"></i> Parent Testimonials
                        </a>
                    </li>
                    <li class="mt-3">
                        <hr class="border-secondary my-2">
                    </li>
                    <li>
                        <a href="~/Admin/ChangePassword.aspx" runat="server" class="nav-link">
                            <i class="bi bi-key me-2"></i> Change Password
                        </a>
                    </li>
                    <li>
                        <a href="~/Default.aspx" target="_blank" runat="server" class="nav-link text-warning">
                            <i class="bi bi-box-arrow-up-right me-2"></i> View Live Site
                        </a>
                    </li>
                </ul>

                <hr class="border-secondary my-2">
                <div class="d-flex align-items-center justify-content-between px-2 text-white">
                    <div class="small">
                        <div class="fw-bold"><asp:Literal ID="litAdminName" runat="server" Text="Administrator" /></div>
                        <div class="text-secondary" style="font-size: 0.7rem;"><asp:Literal ID="litAdminRole" runat="server" Text="SuperAdmin" /></div>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="btn btn-sm btn-outline-danger" ToolTip="Log out">
                        <i class="bi bi-box-arrow-right"></i>
                    </asp:LinkButton>
                </div>
            </aside>

            <!-- Main Admin Workspace -->
            <div class="flex-grow-1 d-flex flex-column" style="overflow-y: auto;">
                <!-- Admin Header -->
                <header class="bg-white border-bottom p-3 d-flex justify-content-between align-items-center shadow-sm">
                    <h5 class="m-0 fw-bold text-primary"><asp:Literal ID="litPageHeading" runat="server" Text="Administrative Dashboard" /></h5>
                    <div class="d-flex align-items-center gap-3">
                        <a href="~/Default.aspx" target="_blank" runat="server" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-globe me-1"></i> Public Website
                        </a>
                        <asp:LinkButton ID="btnTopLogout" runat="server" OnClick="btnLogout_Click" CssClass="btn btn-sm btn-danger">
                            <i class="bi bi-box-arrow-right me-1"></i> Logout
                        </asp:LinkButton>
                    </div>
                </header>

                <!-- Admin Main Body -->
                <main class="p-4 flex-grow-1">
                    <asp:ContentPlaceHolder ID="AdminContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <asp:ContentPlaceHolder ID="AdminScripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
